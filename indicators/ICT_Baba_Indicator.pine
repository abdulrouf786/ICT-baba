//@version=6
indicator("ICT Baba - Liquidity, MSS, FVG & Retest", shorttitle="ICT Baba", overlay=true, max_boxes_count=100, max_lines_count=100, max_labels_count=100)

// ICT Baba indicator - chart signals only. No orders are placed.
groupICT = "ICT Settings"
pivotLen = input.int(3, "Swing pivot length", minval=1, maxval=20, group=groupICT)
setupWindow = input.int(30, "Sweep/MSS validity (bars)", minval=1, maxval=200, group=groupICT)
rr = input.float(2.0, "Take-profit risk/reward", minval=0.5, maxval=10, step=0.25, group=groupICT)
slBufferTicks = input.int(2, "Stop buffer (ticks)", minval=0, maxval=100, group=groupICT)
showSwings = input.bool(true, "Show swing levels", group=groupICT)
showFVG = input.bool(true, "Show Fair Value Gaps", group=groupICT)
showTradeLevels = input.bool(true, "Show Entry / SL / TP", group=groupICT)
showDashboard = input.bool(true, "Show status panel", group=groupICT)

bullColor = color.new(color.lime, 0)
bearColor = color.new(color.red, 0)
bullFvgColor = color.new(color.teal, 84)
bearFvgColor = color.new(color.maroon, 84)

// Confirmed swing points
pivotHigh = ta.pivothigh(high, pivotLen, pivotLen)
pivotLow = ta.pivotlow(low, pivotLen, pivotLen)
var float lastSwingHigh = na
var float lastSwingLow = na
var int lastSwingHighBar = na
var int lastSwingLowBar = na

if not na(pivotHigh)
    lastSwingHigh := pivotHigh
    lastSwingHighBar := bar_index - pivotLen
if not na(pivotLow)
    lastSwingLow := pivotLow
    lastSwingLowBar := bar_index - pivotLen

// Liquidity sweeps: price runs a confirmed swing and closes back inside.
bearSweep = not na(lastSwingHigh) and high > lastSwingHigh and close < lastSwingHigh
bullSweep = not na(lastSwingLow) and low < lastSwingLow and close > lastSwingLow

var int lastBullSweepBar = na
var int lastBearSweepBar = na
var float lastBullSweepLow = na
var float lastBearSweepHigh = na
if bullSweep
    lastBullSweepBar := bar_index
    lastBullSweepLow := low
if bearSweep
    lastBearSweepBar := bar_index
    lastBearSweepHigh := high

// Market structure shift / break of structure using the latest confirmed swing.
bullMSS = not na(lastSwingHigh) and close > lastSwingHigh and close[1] <= lastSwingHigh
bearMSS = not na(lastSwingLow) and close < lastSwingLow and close[1] >= lastSwingLow

var int lastBullMssBar = na
var int lastBearMssBar = na
if bullMSS
    lastBullMssBar := bar_index
if bearMSS
    lastBearMssBar := bar_index

// Three-candle Fair Value Gap.
bullFVG = bar_index >= 2 and low > high[2]
bearFVG = bar_index >= 2 and high < low[2]

var float bullFvgTop = na
var float bullFvgBottom = na
var int bullFvgBar = na
var float bearFvgTop = na
var float bearFvgBottom = na
var int bearFvgBar = na
var box bullBox = na
var box bearBox = na

if bullFVG
    bullFvgTop := low
    bullFvgBottom := high[2]
    bullFvgBar := bar_index
    if showFVG
        bullBox := box.new(left=bar_index - 2, top=bullFvgTop, right=bar_index + 20, bottom=bullFvgBottom, bgcolor=bullFvgColor, border_color=color.new(color.teal, 45))
if bearFVG
    bearFvgTop := low[2]
    bearFvgBottom := high
    bearFvgBar := bar_index
    if showFVG
        bearBox := box.new(left=bar_index - 2, top=bearFvgTop, right=bar_index + 20, bottom=bearFvgBottom, bgcolor=bearFvgColor, border_color=color.new(color.maroon, 45))

// Retest: candle trades back into the latest FVG after it was created.
bullRetest = not na(bullFvgBar) and bar_index > bullFvgBar and low <= bullFvgTop and high >= bullFvgBottom and close > bullFvgBottom
bearRetest = not na(bearFvgBar) and bar_index > bearFvgBar and high >= bearFvgBottom and low <= bearFvgTop and close < bearFvgTop

bullSweepRecent = not na(lastBullSweepBar) and bar_index - lastBullSweepBar <= setupWindow
bearSweepRecent = not na(lastBearSweepBar) and bar_index - lastBearSweepBar <= setupWindow
bullMssRecent = not na(lastBullMssBar) and bar_index - lastBullMssBar <= setupWindow
bearMssRecent = not na(lastBearMssBar) and bar_index - lastBearMssBar <= setupWindow

var int lastBullSignalFvgBar = na
var int lastBearSignalFvgBar = na
buySignal = bullRetest and bullSweepRecent and bullMssRecent and (na(lastBullSignalFvgBar) or lastBullSignalFvgBar != bullFvgBar)
sellSignal = bearRetest and bearSweepRecent and bearMssRecent and (na(lastBearSignalFvgBar) or lastBearSignalFvgBar != bearFvgBar)

if buySignal
    lastBullSignalFvgBar := bullFvgBar
if sellSignal
    lastBearSignalFvgBar := bearFvgBar

// Entry, stop and target levels are illustrative chart levels, not execution instructions.
var line entryLine = na
var line stopLine = na
var line targetLine = na
var label tradeLabel = na
var float lastEntry = na
var float lastSL = na
var float lastTP = na
var string lastSide = "Waiting"

if buySignal
    lastEntry := close
    lastSL := (na(lastBullSweepLow) ? low : math.min(lastBullSweepLow, low)) - slBufferTicks * syminfo.mintick
    risk = math.max(lastEntry - lastSL, syminfo.mintick)
    lastTP := lastEntry + risk * rr
    lastSide := "BUY"
    if showTradeLevels
        line.delete(entryLine)
        line.delete(stopLine)
        line.delete(targetLine)
        label.delete(tradeLabel)
        entryLine := line.new(bar_index, lastEntry, bar_index + 25, lastEntry, color=color.blue, width=2)
        stopLine := line.new(bar_index, lastSL, bar_index + 25, lastSL, color=color.red, width=2)
        targetLine := line.new(bar_index, lastTP, bar_index + 25, lastTP, color=color.lime, width=2)
        tradeLabel := label.new(bar_index, low, "ICT BUY\nEntry: " + str.tostring(lastEntry, format.mintick) + "\nSL: " + str.tostring(lastSL, format.mintick) + "\nTP: " + str.tostring(lastTP, format.mintick), style=label.style_label_up, color=color.new(color.green, 0), textcolor=color.white)

if sellSignal
    lastEntry := close
    lastSL := (na(lastBearSweepHigh) ? high : math.max(lastBearSweepHigh, high)) + slBufferTicks * syminfo.mintick
    risk = math.max(lastSL - lastEntry, syminfo.mintick)
    lastTP := lastEntry - risk * rr
    lastSide := "SELL"
    if showTradeLevels
        line.delete(entryLine)
        line.delete(stopLine)
        line.delete(targetLine)
        label.delete(tradeLabel)
        entryLine := line.new(bar_index, lastEntry, bar_index + 25, lastEntry, color=color.blue, width=2)
        stopLine := line.new(bar_index, lastSL, bar_index + 25, lastSL, color=color.red, width=2)
        targetLine := line.new(bar_index, lastTP, bar_index + 25, lastTP, color=color.lime, width=2)
        tradeLabel := label.new(bar_index, high, "ICT SELL\nEntry: " + str.tostring(lastEntry, format.mintick) + "\nSL: " + str.tostring(lastSL, format.mintick) + "\nTP: " + str.tostring(lastTP, format.mintick), style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white)

// Visual markers and swing references
plotshape(bullSweep, title="Bullish liquidity sweep", style=shape.triangleup, location=location.belowbar, color=color.aqua, size=size.tiny, text="SSL")
plotshape(bearSweep, title="Bearish liquidity sweep", style=shape.triangledown, location=location.abovebar, color=color.orange, size=size.tiny, text="BSL")
plotshape(bullMSS, title="Bullish MSS / BOS", style=shape.labelup, location=location.belowbar, color=color.new(color.green, 0), textcolor=color.white, size=size.tiny, text="MSS")
plotshape(bearMSS, title="Bearish MSS / BOS", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0), textcolor=color.white, size=size.tiny, text="MSS")
plotshape(buySignal, title="ICT BUY signal", style=shape.labelup, location=location.belowbar, color=color.green, textcolor=color.white, text="BUY")
plotshape(sellSignal, title="ICT SELL signal", style=shape.labeldown, location=location.abovebar, color=color.red, textcolor=color.white, text="SELL")
plot(showSwings ? lastSwingHigh : na, "Latest swing high / BSL", color=color.new(color.red, 55), style=plot.style_linebr)
plot(showSwings ? lastSwingLow : na, "Latest swing low / SSL", color=color.new(color.green, 55), style=plot.style_linebr)

// Status panel
var table panel = table.new(position.top_right, 2, 4, border_width=1)
if barstate.islast and showDashboard
    table.cell(panel, 0, 0, "ICT BABA", bgcolor=color.new(color.blue, 15), text_color=color.white)
    table.cell(panel, 1, 0, "STATUS", bgcolor=color.new(color.blue, 15), text_color=color.white)
    table.cell(panel, 0, 1, "Last signal")
    table.cell(panel, 1, 1, lastSide)
    table.cell(panel, 0, 2, "Entry")
    table.cell(panel, 1, 2, na(lastEntry) ? "—" : str.tostring(lastEntry, format.mintick))
    table.cell(panel, 0, 3, "SL / TP")
    table.cell(panel, 1, 3, na(lastSL) ? "—" : str.tostring(lastSL, format.mintick) + " / " + str.tostring(lastTP, format.mintick))

alertcondition(bullSweep, title="ICT Baba Bullish Liquidity Sweep", message="ICT Baba: bullish liquidity sweep on {{ticker}} {{interval}}")
alertcondition(bearSweep, title="ICT Baba Bearish Liquidity Sweep", message="ICT Baba: bearish liquidity sweep on {{ticker}} {{interval}}")
alertcondition(bullMSS, title="ICT Baba Bullish MSS", message="ICT Baba: bullish MSS/BOS on {{ticker}} {{interval}}")
alertcondition(bearMSS, title="ICT Baba Bearish MSS", message="ICT Baba: bearish MSS/BOS on {{ticker}} {{interval}}")
alertcondition(buySignal, title="ICT Baba BUY", message="ICT Baba BUY signal on {{ticker}} {{interval}}. Check chart for Entry, SL and TP.")
alertcondition(sellSignal, title="ICT Baba SELL", message="ICT Baba SELL signal on {{ticker}} {{interval}}. Check chart for Entry, SL and TP.")
